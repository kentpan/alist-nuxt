{
  "name": "alist-nuxt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "nuxt preview --host 127.0.0.1",
    "typecheck": "nuxt typecheck",
    "test": "node --experimental-strip-types --experimental-sqlite --test tests/*.test.*",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "6.19.1",
    "@prisma/client": "6.19.1",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/typography": "0.5.16",
    "nuxt": "4.4.8",
    "prisma": "6.19.1",
    "tailwindcss": "3.4.19",
    "crypto-js": "4.2.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "eslint": "9.28.0",
    "typescript": "5.8.3",
    "vue-tsc": "2.2.10",
    "@types/crypto-js": "4.2.2",
    "@types/qrcode": "1.5.5"
  }
}

# Local-only defaults. Never put production credentials in this file.
NODE_ENV=development
DATABASE_URL="file:../data/alist-nuxt.db"
DATABASE_PATH=./data/alist-nuxt.db
NITRO_PRESET=node-server
# Cloudflare D1 is injected as the DB binding by the Worker runtime.

# Local-only authentication bootstrap. Replace before using this workspace.
JWT_SECRET=local-development-only-change-this-secret
ADMIN_TOKEN=
# Required before saving WebDAV username/password. Use a unique random secret (32+ chars).
# In Cloudflare set the Worker secret NUXT_STORAGE_CREDENTIALS_KEY.
STORAGE_CREDENTIALS_KEY=
TOKEN_EXPIRES_IN=48
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-password-before-first-run
ALLOW_REGISTER=false
